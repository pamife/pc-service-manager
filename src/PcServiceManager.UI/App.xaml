<Application x:Class="PcServiceManager.UI.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:vm="clr-namespace:PcServiceManager.UI.ViewModels"
             xmlns:views="clr-namespace:PcServiceManager.UI.Views">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ui:ThemesDictionary Theme="Dark" />
                <ui:ControlsDictionary />
            </ResourceDictionary.MergedDictionaries>

            <!-- ViewModel to View Mappings -->
            <DataTemplate DataType="{x:Type vm:DashboardViewModel}">
                <views:DashboardView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:MaintenanceViewModel}">
                <views:MaintenanceView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:ServiceModeViewModel}">
                <views:ServiceModeView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:HistoryViewModel}">
                <views:HistoryView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:PcInfoViewModel}">
                <views:PcInfoView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
                <views:SettingsView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:FirstLaunchWizardViewModel}">
                <views:FirstLaunchWizardView />
            </DataTemplate>

        </ResourceDictionary>
    </Application.Resources>
</Application>
