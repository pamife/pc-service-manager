<UserControl x:Class="PcServiceManager.UI.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:converters="clr-namespace:PcServiceManager.UI.Converters"
             mc:Ignorable="d" 
             d:DesignHeight="800" d:DesignWidth="1100">
    <UserControl.Resources>
        <converters:StatusToBrushConverter x:Key="StatusToBrushConverter"/>
        <converters:StatusToBackgroundBrushConverter x:Key="StatusToBackgroundBrushConverter"/>
        <converters:BoolToVisibilityConverter x:Key="BoolToVis"/>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="28,24,28,32">
        <StackPanel MaxWidth="1200" HorizontalAlignment="Stretch">

            <!-- Hero PC Banner Card -->
            <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" 
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" 
                    BorderThickness="1" CornerRadius="10" Padding="28,24" Margin="0,0,0,24">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,6">
                            <ui:SymbolIcon Symbol="Desktop24" FontSize="26" Margin="0,0,10,0" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"/>
                            <TextBlock Text="{Binding PcName}" FontSize="26" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock Text="{Binding DeviceSummary}" FontSize="13" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                    </StackPanel>

                    <!-- Overall Health Status Pill Badge -->
                    <Border Grid.Column="1" 
                            Background="{Binding OverallStatus, Converter={StaticResource StatusToBackgroundBrushConverter}}" 
                            BorderBrush="{Binding OverallStatus, Converter={StaticResource StatusToBrushConverter}}" 
                            BorderThickness="1.5" CornerRadius="20" Padding="18,8" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse Width="10" Height="10" Fill="{Binding OverallStatus, Converter={StaticResource StatusToBrushConverter}}" Margin="0,0,8,0"/>
                            <TextBlock Text="Overall Status: " FontSize="13" FontWeight="Normal" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                            <TextBlock Text="{Binding OverallStatusText}" FontSize="13" FontWeight="Bold" Foreground="{Binding OverallStatus, Converter={StaticResource StatusToBrushConverter}}"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- Key Metrics Grid -->
            <Grid Margin="0,0,0,24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Next Upcoming Maintenance Card -->
                <Border Grid.Column="0" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" 
                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" 
                        BorderThickness="1" CornerRadius="10" Padding="20,18">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <ui:SymbolIcon Symbol="CalendarClock24" FontSize="20" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" Margin="0,0,8,0"/>
                            <TextBlock Text="NEXT UPCOMING" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                        </StackPanel>
                        <TextBlock Text="{Binding NextMaintenanceTitle}" FontSize="17" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Margin="0,0,0,4"/>
                        <TextBlock Text="{Binding NextMaintenanceSubtitle}" FontSize="13" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" FontWeight="Medium"/>
                    </StackPanel>
                </Border>

                <!-- Overdue Tasks Count Card -->
                <Border Grid.Column="2" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" 
                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" 
                        BorderThickness="1" CornerRadius="10" Padding="20,18">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <ui:SymbolIcon Symbol="Warning24" FontSize="20" Foreground="#EF4444" Margin="0,0,8,0"/>
                            <TextBlock Text="OVERDUE TASKS" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                        </StackPanel>
                        <TextBlock Text="{Binding OverdueCount}" FontSize="28" FontWeight="Bold" Foreground="#EF4444" Margin="0,0,0,2"/>
                        <TextBlock Text="Requires immediate attention" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                    </StackPanel>
                </Border>

                <!-- Due Soon Tasks Count Card -->
                <Border Grid.Column="4" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" 
                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" 
                        BorderThickness="1" CornerRadius="10" Padding="20,18">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <ui:SymbolIcon Symbol="Clock24" FontSize="20" Foreground="#F59E0B" Margin="0,0,8,0"/>
                            <TextBlock Text="DUE SOON" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                        </StackPanel>
                        <TextBlock Text="{Binding DueSoonCount}" FontSize="28" FontWeight="Bold" Foreground="#F59E0B" Margin="0,0,0,2"/>
                        <TextBlock Text="Scheduled in upcoming days" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Quick Action Command Center & Last Service -->
            <Grid Margin="0,0,0,24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="1.5*"/>
                </Grid.ColumnDefinitions>

                <!-- Quick Action Buttons Card -->
                <Border Grid.Column="0" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" 
                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" 
                        BorderThickness="1" CornerRadius="10" Padding="24,20">
                    <StackPanel>
                        <TextBlock Text="Maintenance Quick Actions" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,16"/>

                        <!-- Primary Start Service Button -->
                        <ui:Button Command="{Binding StartServiceCommand}" 
                                Appearance="Primary" 
                                HorizontalAlignment="Stretch" 
                                Height="48" 
                                Margin="0,0,0,12" 
                                FontSize="15" 
                                FontWeight="SemiBold">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="PlayCircle24" FontSize="20" Margin="0,0,10,0"/>
                                <TextBlock Text="Start Guided Service Session" VerticalAlignment="Center"/>
                            </StackPanel>
                        </ui:Button>

                        <!-- Secondary Action Grid -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <ui:Button Grid.Column="0" Command="{Binding NavigateMaintenanceCommand}" HorizontalAlignment="Stretch" Height="40">
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="CheckboxChecked24" FontSize="16" Margin="0,0,8,0"/>
                                    <TextBlock Text="All Tasks" VerticalAlignment="Center"/>
                                </StackPanel>
                            </ui:Button>

                            <ui:Button Grid.Column="2" Command="{Binding NavigateHistoryCommand}" HorizontalAlignment="Stretch" Height="40">
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="History24" FontSize="16" Margin="0,0,8,0"/>
                                    <TextBlock Text="Service Book" VerticalAlignment="Center"/>
                                </StackPanel>
                            </ui:Button>
                        </Grid>

                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <ui:Button Grid.Column="0" Command="{Binding NavigatePcInfoCommand}" HorizontalAlignment="Stretch" Height="40">
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="Info24" FontSize="16" Margin="0,0,8,0"/>
                                    <TextBlock Text="PC Information" VerticalAlignment="Center"/>
                                </StackPanel>
                            </ui:Button>

                            <ui:Button Grid.Column="2" Command="{Binding NavigateSettingsCommand}" HorizontalAlignment="Stretch" Height="40">
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="Settings24" FontSize="16" Margin="0,0,8,0"/>
                                    <TextBlock Text="Settings" VerticalAlignment="Center"/>
                                </StackPanel>
                            </ui:Button>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Last Service Overview Card -->
                <Border Grid.Column="2" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" 
                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" 
                        BorderThickness="1" CornerRadius="10" Padding="20,20">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <ui:SymbolIcon Symbol="ShieldCheckmark24" FontSize="20" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" Margin="0,0,8,0"/>
                            <TextBlock Text="LAST COMPLETED SERVICE" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                        </StackPanel>
                        <TextBlock Text="{Binding LastServiceDate}" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,6"/>
                        <TextBlock Text="{Binding LastServiceDetails}" FontSize="13" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" Margin="0,0,0,16"/>
                        <ui:Button Command="{Binding NavigateHistoryCommand}" HorizontalAlignment="Left" Appearance="Secondary">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="View Service History" Margin="0,0,6,0"/>
                                <ui:SymbolIcon Symbol="ArrowRight24" FontSize="14"/>
                            </StackPanel>
                        </ui:Button>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Recent Service Sessions Logbook -->
            <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" 
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" 
                    BorderThickness="1" CornerRadius="10" Padding="24,20">
                <StackPanel>
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Recent Service History" FontSize="16" FontWeight="SemiBold"/>
                        <ui:Button Grid.Column="1" Command="{Binding NavigateHistoryCommand}" Appearance="Transparent" Padding="8,4">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="View All" Margin="0,0,4,0"/>
                                <ui:SymbolIcon Symbol="ChevronRight24" FontSize="12"/>
                            </StackPanel>
                        </ui:Button>
                    </Grid>

                    <!-- Items List -->
                    <ItemsControl ItemsSource="{Binding RecentSessions}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,0,1" Padding="0,12">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="140"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="120"/>
                                            <ColumnDefinition Width="120"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding StartTime, StringFormat='{}{0:dd MMM yyyy}'}" FontWeight="SemiBold" FontSize="13"/>
                                            <TextBlock Text="{Binding StartTime, StringFormat='{}{0:HH:mm}'}" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                        </StackPanel>

                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0">
                                            <TextBlock Text="{Binding TemplateName}" FontWeight="SemiBold" FontSize="14"/>
                                            <TextBlock Text="{Binding OverallNote}" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>

                                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding DurationMinutes, StringFormat='{}{0} minutes'}" FontSize="12"/>
                                            <TextBlock Text="{Binding PerformedBy, StringFormat='{}By {0}'}" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                        </StackPanel>

                                        <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right">
                                            <Border Background="#2010B981" CornerRadius="12" Padding="8,3" Margin="0,0,4,0">
                                                <TextBlock Text="{Binding CompletedCount, StringFormat='{}✓ {0}'}" FontSize="11" FontWeight="SemiBold" Foreground="#10B981"/>
                                            </Border>
                                            <Border Background="#20EF4444" CornerRadius="12" Padding="8,3">
                                                <TextBlock Text="{Binding NeedsAttentionCount, StringFormat='{}⚠ {0}'}" FontSize="11" FontWeight="SemiBold" Foreground="#EF4444"/>
                                            </Border>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Empty state -->
                    <TextBlock Text="No service records logged yet. Click 'Start Guided Service Session' to perform your first maintenance check." 
                               FontSize="13" Foreground="{DynamicResource TextFillColorSecondaryBrush}" 
                               FontStyle="Italic" Padding="0,12"
                               Visibility="{Binding RecentSessions.Count, Converter={StaticResource BoolToVis}, ConverterParameter=invert}"/>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
