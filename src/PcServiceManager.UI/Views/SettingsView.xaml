<UserControl x:Class="PcServiceManager.UI.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:converters="clr-namespace:PcServiceManager.UI.Converters"
             xmlns:enums="clr-namespace:PcServiceManager.Core.Enums;assembly=PcServiceManager.Core"
             mc:Ignorable="d" 
             d:DesignHeight="1000" d:DesignWidth="1100">
    <UserControl.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVis"/>
        <converters:NullToVisibilityConverter x:Key="NullToVis"/>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="28,24,28,32">
        <StackPanel MaxWidth="1000" HorizontalAlignment="Stretch">

            <!-- Header -->
            <StackPanel Margin="0,0,0,24">
                <TextBlock Text="Settings &amp; Preferences" FontSize="26" FontWeight="SemiBold" Margin="0,0,0,4"/>
                <TextBlock Text="Manage maintained PC profiles, notification rules, themes, and full database backups." FontSize="14" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
            </StackPanel>

            <!-- Status Banner -->
            <Border Background="#2010B981" BorderBrush="#10B981" BorderThickness="1" CornerRadius="6" Padding="12,10" Margin="0,0,0,20" Visibility="{Binding StatusMessage, Converter={StaticResource NullToVis}}">
                <TextBlock Text="{Binding StatusMessage}" FontSize="13" Foreground="#10B981"/>
            </Border>

            <!-- Section 1: PC Profiles Management -->
            <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" 
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" 
                    BorderThickness="1" CornerRadius="10" Padding="24" Margin="0,0,0,24">
                <StackPanel>
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Maintained PC Profiles" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,2"/>
                            <TextBlock Text="Select which PC to maintain or create additional PC profiles." FontSize="13" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                        </StackPanel>

                        <ui:Button Grid.Column="1" Command="{Binding ShowAddPcFormCommand}" Appearance="Secondary" Height="36">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Add24" FontSize="16" Margin="0,0,6,0"/>
                                <TextBlock Text="Add Another PC"/>
                            </StackPanel>
                        </ui:Button>
                    </Grid>

                    <!-- Add New PC Form -->
                    <Border Background="{DynamicResource ControlFillColorDefaultBrush}" CornerRadius="8" Padding="16" Margin="0,0,0,16" Visibility="{Binding IsAddingNewPc, Converter={StaticResource BoolToVis}}">
                        <StackPanel>
                            <TextBlock Text="Add New PC Asset" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,12"/>
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <ui:TextBox Grid.Column="0" Text="{Binding NewPcName, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="PC Name (e.g. Sister-Laptop)" Height="36"/>
                                <ComboBox Grid.Column="2" SelectedItem="{Binding NewPcDeviceType}" Height="36" HorizontalAlignment="Stretch">
                                    <enums:DeviceType>Desktop</enums:DeviceType>
                                    <enums:DeviceType>Laptop</enums:DeviceType>
                                    <enums:DeviceType>AllInOne</enums:DeviceType>
                                    <enums:DeviceType>Server</enums:DeviceType>
                                    <enums:DeviceType>Other</enums:DeviceType>
                                </ComboBox>
                            </Grid>
                            <ui:TextBox Text="{Binding NewPcNotes, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="Optional notes or owner details..." Height="36" Margin="0,0,0,12"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Content="Cancel" Command="{Binding CancelAddPcCommand}" Margin="0,0,8,0" Height="32"/>
                                <ui:Button Content="Create PC" Command="{Binding CreateNewPcCommand}" Appearance="Primary" Height="32" Padding="16,0"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- PCs Selection Grid -->
                    <ComboBox ItemsSource="{Binding PcList}" SelectedItem="{Binding SelectedPc}" DisplayMemberPath="Name" Height="38" Margin="0,0,0,16" HorizontalAlignment="Stretch"/>

                    <!-- Edit Selected PC Details -->
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="PC Name" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,4"/>
                            <TextBox Text="{Binding EditPcName, UpdateSourceTrigger=PropertyChanged}" Height="36"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Device Form Factor" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,4"/>
                            <ComboBox SelectedItem="{Binding EditPcDeviceType}" Height="36" HorizontalAlignment="Stretch">
                                <enums:DeviceType>Desktop</enums:DeviceType>
                                <enums:DeviceType>Laptop</enums:DeviceType>
                                <enums:DeviceType>AllInOne</enums:DeviceType>
                                <enums:DeviceType>Server</enums:DeviceType>
                                <enums:DeviceType>Other</enums:DeviceType>
                            </ComboBox>
                        </StackPanel>
                    </Grid>

                    <StackPanel Margin="0,0,0,16">
                        <TextBlock Text="Notes / Description" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding EditPcNotes, UpdateSourceTrigger=PropertyChanged}" Height="50" AcceptsReturn="True" TextWrapping="Wrap"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <ui:Button Command="{Binding DeleteSelectedPcCommand}" Appearance="Transparent" Margin="0,0,10,0" Height="36">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Delete24" Foreground="#EF4444" FontSize="14" Margin="0,0,6,0"/>
                                <TextBlock Text="Delete PC" Foreground="#EF4444"/>
                            </StackPanel>
                        </ui:Button>
                        <ui:Button Command="{Binding SavePcDetailsCommand}" Appearance="Primary" Content="Save PC Info" Height="36" Padding="16,0"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Section 2: Appearance & Theme -->
            <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" 
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" 
                    BorderThickness="1" CornerRadius="10" Padding="24" Margin="0,0,0,24">
                <StackPanel>
                    <TextBlock Text="Application Theme" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,2"/>
                    <TextBlock Text="Choose your preferred Windows 11 Fluent theme." FontSize="13" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,16"/>

                    <ComboBox SelectedItem="{Binding CurrentTheme}" Height="38" HorizontalAlignment="Stretch" Margin="0,0,0,16">
                        <enums:AppTheme>System</enums:AppTheme>
                        <enums:AppTheme>Dark</enums:AppTheme>
                        <enums:AppTheme>Light</enums:AppTheme>
                    </ComboBox>
                </StackPanel>
            </Border>

            <!-- Section 3: Maintenance Schedule & Rules -->
            <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" 
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" 
                    BorderThickness="1" CornerRadius="10" Padding="24" Margin="0,0,0,24">
                <StackPanel>
                    <TextBlock Text="Maintenance Schedule Rules" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,2"/>
                    <TextBlock Text="Configure how early tasks are marked as 'Due Soon' and default technician signatures." FontSize="13" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,16"/>

                    <!-- Due Soon Threshold Slider -->
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Due Soon Threshold" FontSize="14" FontWeight="SemiBold"/>
                            <TextBlock Text="Tasks due within this number of days will show yellow warning badges." FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                        </StackPanel>

                        <TextBlock Grid.Column="1" Text="{Binding DueSoonDaysThreshold, StringFormat='{}{0} days'}" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" VerticalAlignment="Center"/>
                    </Grid>

                    <Slider Minimum="1" Maximum="30" Value="{Binding DueSoonDaysThreshold}" TickFrequency="1" IsSnapToTickEnabled="True" Margin="0,0,0,20"/>

                    <!-- Default Technician Name -->
                    <StackPanel Margin="0,0,0,16">
                        <TextBlock Text="Default Technician Name" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,4"/>
                        <ui:TextBox Text="{Binding DefaultTechnicianName, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="Name appearing on service records" Height="36"/>
                    </StackPanel>

                    <!-- Windows Notifications Toggle -->
                    <Grid Margin="0,0,0,20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Windows Toast Notifications" FontSize="14" FontWeight="SemiBold"/>
                            <TextBlock Text="Show desktop notifications on startup when maintenance tasks are overdue or due soon." FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                        </StackPanel>

                        <ui:ToggleSwitch Grid.Column="1" IsChecked="{Binding NotificationsEnabled}"/>
                    </Grid>

                    <ui:Button Command="{Binding SaveSettingsCommand}" Appearance="Primary" Content="Save Preferences" Height="36" HorizontalAlignment="Right" Padding="16,0"/>
                </StackPanel>
            </Border>

            <!-- Section 4: Backup, Import & Export -->
            <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" 
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" 
                    BorderThickness="1" CornerRadius="10" Padding="24" Margin="0,0,0,24">
                <StackPanel>
                    <TextBlock Text="Backup &amp; Data Portability" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,2"/>
                    <TextBlock Text="Safely export complete PC profiles, maintenance schedules, and digital service history." FontSize="13" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,16"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Export JSON Backup -->
                        <ui:Button Grid.Column="0" Command="{Binding ExportBackupJsonCommand}" Height="44" HorizontalAlignment="Stretch">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="ArrowDownload24" FontSize="16" Margin="0,0,8,0"/>
                                <TextBlock Text="Export Full JSON Backup" VerticalAlignment="Center"/>
                            </StackPanel>
                        </ui:Button>

                        <!-- Import JSON Backup -->
                        <ui:Button Grid.Column="2" Command="{Binding ImportBackupJsonCommand}" Height="44" HorizontalAlignment="Stretch">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="ArrowUpload24" FontSize="16" Margin="0,0,8,0"/>
                                <TextBlock Text="Import JSON Backup" VerticalAlignment="Center"/>
                            </StackPanel>
                        </ui:Button>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Section 5: Reset Application Database -->
            <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" 
                    BorderBrush="#30EF4444" 
                    BorderThickness="1" CornerRadius="10" Padding="24">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Factory Reset Application Data" FontSize="16" FontWeight="SemiBold" Foreground="#EF4444" Margin="0,0,0,2"/>
                        <TextBlock Text="Permanently erases all PCs, tasks, and service history and restores default state." FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                    </StackPanel>

                    <ui:Button Grid.Column="1" Command="{Binding ResetAllDataCommand}" Appearance="Danger" Height="36" Padding="16,0">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Delete24" FontSize="14" Margin="0,0,6,0"/>
                            <TextBlock Text="Reset Database"/>
                        </StackPanel>
                    </ui:Button>
                </Grid>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
