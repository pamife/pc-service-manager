<UserControl x:Class="PcServiceManager.UI.Views.ServiceModeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:converters="clr-namespace:PcServiceManager.UI.Converters"
             xmlns:vm="clr-namespace:PcServiceManager.UI.ViewModels"
             mc:Ignorable="d" 
             d:DesignHeight="900" d:DesignWidth="1100">
    <UserControl.Resources>
        <converters:StatusToBrushConverter x:Key="StatusToBrushConverter"/>
        <converters:BoolToVisibilityConverter x:Key="BoolToVis"/>
        <converters:NullToVisibilityConverter x:Key="NullToVis"/>
    </UserControl.Resources>

    <Grid>
        <!-- ========================================================================= -->
        <!-- STEP 1: TEMPLATE SELECTION SCREEN                                         -->
        <!-- ========================================================================= -->
        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="28,24,28,32">
            <ScrollViewer.Style>
                <Style TargetType="ScrollViewer">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding CurrentStep}" Value="{x:Static vm:ServiceSessionStep.TemplateSelection}">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </ScrollViewer.Style>

            <StackPanel MaxWidth="1000" HorizontalAlignment="Stretch">
                <TextBlock Text="Start Guided Maintenance Session" FontSize="26" FontWeight="SemiBold" Margin="0,0,0,6"/>
                <TextBlock Text="Select a maintenance template to begin an interactive inspection checklist for this PC." FontSize="14" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,24"/>

                <!-- Service Technician Name Card -->
                <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" 
                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" 
                        BorderThickness="1" CornerRadius="10" Padding="20" Margin="0,0,0,24">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="TARGET PC" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,4"/>
                            <TextBlock Text="{Binding PcName}" FontSize="18" FontWeight="SemiBold"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="SERVICED BY (TECHNICIAN NAME)" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,4"/>
                            <ui:TextBox Text="{Binding TechnicianName, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="Your Name" Height="36"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <TextBlock Text="Select Service Template" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,12"/>

                <!-- Template Selector Quick List -->
                <ComboBox ItemsSource="{Binding AvailableTemplates}" 
                          SelectedItem="{Binding SelectedTemplate}" 
                          DisplayMemberPath="Name" 
                          Height="38" 
                          Margin="0,0,0,24" 
                          HorizontalAlignment="Stretch"/>

                <ui:Button Command="{Binding StartServiceSessionCommand}" 
                        Appearance="Primary" 
                        Height="50" 
                        HorizontalAlignment="Stretch" 
                        FontSize="16" 
                        FontWeight="SemiBold">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="Play24" FontSize="20" Margin="0,0,10,0"/>
                        <TextBlock Text="Begin Guided Service Session" VerticalAlignment="Center"/>
                    </StackPanel>
                </ui:Button>
            </StackPanel>
        </ScrollViewer>

        <!-- ========================================================================= -->
        <!-- STEP 2: ACTIVE GUIDED CHECKLIST SESSION                                   -->
        <!-- ========================================================================= -->
        <Grid>
            <Grid.Style>
                <Style TargetType="Grid">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding CurrentStep}" Value="{x:Static vm:ServiceSessionStep.ActiveChecklist}">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Sticky Top Control Bar -->
            <Border Grid.Row="0" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" 
                    BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}" 
                    BorderThickness="0,0,0,1" Padding="28,16">
                <Grid MaxWidth="1200">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Live Timer & PC Badge -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Background="{DynamicResource AccentFillColorDefaultBrush}" CornerRadius="6" Padding="12,6" Margin="0,0,14,0">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Clock24" FontSize="16" Foreground="White" Margin="0,0,6,0"/>
                                <TextBlock Text="{Binding FormattedElapsedTime}" FontSize="15" FontWeight="Bold" Foreground="White"/>
                            </StackPanel>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{Binding PcName}" FontSize="15" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding SelectedTemplate.Name}" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- Center Progress Metrics -->
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="30,0">
                        <Grid Margin="0,0,0,4">
                            <TextBlock Text="{Binding CompletedCount, StringFormat='{}{0} Completed'}" FontSize="12" FontWeight="SemiBold" Foreground="#10B981" HorizontalAlignment="Left"/>
                            <TextBlock Text="{Binding TotalTasksCount, StringFormat='{}{0} Total Tasks'}" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" HorizontalAlignment="Right"/>
                        </Grid>
                        <ProgressBar Value="{Binding ProgressPercent}" Maximum="100" Height="6"/>
                    </StackPanel>

                    <!-- Top Action Buttons -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <ui:Button Command="{Binding MarkAllCompletedCommand}" Appearance="Secondary" Content="Mark All Done" Height="36" Margin="0,0,10,0"/>
                        <ui:Button Command="{Binding CancelSessionCommand}" Appearance="Transparent" Content="Cancel" Height="36" Margin="0,0,10,0"/>
                        <ui:Button Command="{Binding ReviewAndCompleteCommand}" Appearance="Primary" Height="36" Padding="16,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Review &amp; Finish" FontWeight="SemiBold" Margin="0,0,6,0"/>
                                <ui:SymbolIcon Symbol="Checkmark24" FontSize="14"/>
                            </StackPanel>
                        </ui:Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Scrollable Interactive Tasks Checklist -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="28,20,28,32">
                <StackPanel MaxWidth="1200" HorizontalAlignment="Stretch">

                    <ItemsControl ItemsSource="{Binding ChecklistItems}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" 
                                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" 
                                        BorderThickness="1" CornerRadius="10" Padding="20" Margin="0,0,0,16">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <!-- Row 0: Category, Title, Status Selector -->
                                        <Grid Grid.Row="0" Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding CategoryName}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,2"/>
                                                <TextBlock Text="{Binding Title}" FontSize="17" FontWeight="SemiBold"/>
                                            </StackPanel>

                                            <!-- 4 Status Action Buttons -->
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                <!-- Completed Button -->
                                                <Button Command="{Binding SetStatusCommand}" CommandParameter="Completed" Height="34" Padding="10,0" Margin="0,0,4,0">
                                                    <Button.Style>
                                                        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsCompleted}" Value="True">
                                                                    <Setter Property="Background" Value="#2510B981"/>
                                                                    <Setter Property="BorderBrush" Value="#10B981"/>
                                                                    <Setter Property="Foreground" Value="#10B981"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Button.Style>
                                                    <StackPanel Orientation="Horizontal">
                                                        <ui:SymbolIcon Symbol="Checkmark24" FontSize="14" Margin="0,0,4,0"/>
                                                        <TextBlock Text="Completed" FontSize="12" FontWeight="SemiBold"/>
                                                    </StackPanel>
                                                </Button>

                                                <!-- Skipped Button -->
                                                <Button Command="{Binding SetStatusCommand}" CommandParameter="Skipped" Height="34" Padding="10,0" Margin="0,0,4,0">
                                                    <Button.Style>
                                                        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsSkipped}" Value="True">
                                                                    <Setter Property="Background" Value="#25F59E0B"/>
                                                                    <Setter Property="BorderBrush" Value="#F59E0B"/>
                                                                    <Setter Property="Foreground" Value="#F59E0B"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Button.Style>
                                                    <StackPanel Orientation="Horizontal">
                                                        <ui:SymbolIcon Symbol="Next24" FontSize="14" Margin="0,0,4,0"/>
                                                        <TextBlock Text="Skip" FontSize="12"/>
                                                    </StackPanel>
                                                </Button>

                                                <!-- Needs Attention Button -->
                                                <Button Command="{Binding SetStatusCommand}" CommandParameter="NeedsAttention" Height="34" Padding="10,0" Margin="0,0,4,0">
                                                    <Button.Style>
                                                        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsNeedsAttention}" Value="True">
                                                                    <Setter Property="Background" Value="#25EF4444"/>
                                                                    <Setter Property="BorderBrush" Value="#EF4444"/>
                                                                    <Setter Property="Foreground" Value="#EF4444"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Button.Style>
                                                    <StackPanel Orientation="Horizontal">
                                                        <ui:SymbolIcon Symbol="Warning24" FontSize="14" Margin="0,0,4,0"/>
                                                        <TextBlock Text="Needs Attention" FontSize="12"/>
                                                    </StackPanel>
                                                </Button>

                                                <!-- N/A Button -->
                                                <Button Command="{Binding SetStatusCommand}" CommandParameter="NotApplicable" Height="34" Padding="8,0">
                                                    <Button.Style>
                                                        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsNotApplicable}" Value="True">
                                                                    <Setter Property="Background" Value="#20808080"/>
                                                                    <Setter Property="BorderBrush" Value="#808080"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Button.Style>
                                                    <TextBlock Text="N/A" FontSize="12"/>
                                                </Button>
                                            </StackPanel>
                                        </Grid>

                                        <!-- Row 1: Instructions / Description -->
                                        <StackPanel Grid.Row="1" Margin="0,0,0,10">
                                            <TextBlock Text="{Binding Description}" FontSize="13" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" Margin="0,0,0,6"/>
                                            <Border Background="{DynamicResource ControlFillColorDefaultBrush}" CornerRadius="6" Padding="12,8" Visibility="{Binding DetailedInstructions, Converter={StaticResource NullToVis}}">
                                                <TextBlock Text="{Binding DetailedInstructions}" FontSize="12" Foreground="{DynamicResource TextFillColorPrimaryBrush}" TextWrapping="Wrap"/>
                                            </Border>
                                        </StackPanel>

                                        <!-- Row 2: Safety Warning if Advanced -->
                                        <Border Grid.Row="2" Background="#20EF4444" BorderBrush="#EF4444" BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,0,0,10" Visibility="{Binding SafetyWarning, Converter={StaticResource NullToVis}}">
                                            <StackPanel Orientation="Horizontal">
                                                <ui:SymbolIcon Symbol="Warning24" Foreground="#EF4444" FontSize="16" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="{Binding SafetyWarning}" FontSize="12" Foreground="{DynamicResource TextFillColorPrimaryBrush}" TextWrapping="Wrap"/>
                                            </StackPanel>
                                        </Border>

                                        <!-- Row 3: Quick Action & Task Note Input -->
                                        <Grid Grid.Row="3">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- Quick Tool Launcher Button -->
                                            <ui:Button Grid.Column="0" 
                                                    Command="{Binding ExecuteQuickActionCommand}" 
                                                    Visibility="{Binding HasQuickAction, Converter={StaticResource BoolToVis}}" 
                                                    Appearance="Secondary" 
                                                    Height="32" 
                                                    Padding="12,0" 
                                                    Margin="0,0,12,0">
                                                <StackPanel Orientation="Horizontal">
                                                    <ui:SymbolIcon Symbol="Open24" FontSize="13" Margin="0,0,6,0"/>
                                                    <TextBlock Text="{Binding QuickActionLabel}" FontSize="12"/>
                                                </StackPanel>
                                            </ui:Button>

                                            <!-- Notes input for this task -->
                                            <ui:TextBox Grid.Column="1" 
                                                     Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}" 
                                                     PlaceholderText="Task observation notes (e.g., Cleaned dust filter, installed KB5041585, etc.)..." 
                                                     Height="32" 
                                                     VerticalContentAlignment="Center"/>
                                        </Grid>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <ui:Button Command="{Binding ReviewAndCompleteCommand}" Appearance="Primary" Height="48" HorizontalAlignment="Stretch" Margin="0,12,0,0" FontSize="15" FontWeight="SemiBold">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="CheckmarkCircle24" FontSize="20" Margin="0,0,10,0"/>
                            <TextBlock Text="Review &amp; Finalize Maintenance Session" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ui:Button>

                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- ========================================================================= -->
        <!-- STEP 3: SUMMARY COMPLETION SCREEN                                         -->
        <!-- ========================================================================= -->
        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="28,24,28,32">
            <ScrollViewer.Style>
                <Style TargetType="ScrollViewer">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding CurrentStep}" Value="{x:Static vm:ServiceSessionStep.SummaryCompletion}">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </ScrollViewer.Style>

            <StackPanel MaxWidth="900" HorizontalAlignment="Stretch">
                <!-- Success Header -->
                <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" 
                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" 
                        BorderThickness="1" CornerRadius="10" Padding="28" Margin="0,0,0,24">
                    <StackPanel HorizontalAlignment="Center">
                        <Border Background="#2510B981" Width="64" Height="64" CornerRadius="32" HorizontalAlignment="Center" Margin="0,0,0,16">
                            <ui:SymbolIcon Symbol="Checkmark24" FontSize="32" Foreground="#10B981" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="SERVICE SESSION COMPLETED" FontSize="22" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                        <TextBlock Text="Review the summary below and record your service notes in the digital service book." FontSize="14" Foreground="{DynamicResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <!-- Metrics Grid -->
                <Grid Margin="0,0,0,24">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="16">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="DURATION" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,4"/>
                            <TextBlock Text="{Binding FinalDurationMinutes, StringFormat='{}{0} min'}" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="2" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="16">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="COMPLETED" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,4"/>
                            <TextBlock Text="{Binding CompletedCount}" FontSize="24" FontWeight="Bold" Foreground="#10B981"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="4" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="16">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="SKIPPED" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,4"/>
                            <TextBlock Text="{Binding SkippedCount}" FontSize="24" FontWeight="Bold" Foreground="#F59E0B"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="6" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="16">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="ATTENTION" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,4"/>
                            <TextBlock Text="{Binding NeedsAttentionCount}" FontSize="24" FontWeight="Bold" Foreground="#EF4444"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- General Service Note Input -->
                <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" 
                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" 
                        BorderThickness="1" CornerRadius="10" Padding="20" Margin="0,0,0,24">
                    <StackPanel>
                        <TextBlock Text="General Service Notes &amp; Observations" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,6"/>
                        <TextBlock Text="Record what was done during this service session for the permanent digital service book." FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,10"/>
                        <TextBox Text="{Binding OverallServiceNote, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" Height="100" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <!-- Final Save Action -->
                <ui:Button Command="{Binding FinalizeServiceCommand}" Appearance="Primary" Height="50" HorizontalAlignment="Stretch" FontSize="16" FontWeight="SemiBold">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="Save24" FontSize="20" Margin="0,0,10,0"/>
                        <TextBlock Text="Save to Service Book &amp; Update Due Dates" VerticalAlignment="Center"/>
                    </StackPanel>
                </ui:Button>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
