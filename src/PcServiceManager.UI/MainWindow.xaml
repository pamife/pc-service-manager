<ui:FluentWindow x:Class="PcServiceManager.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:converters="clr-namespace:PcServiceManager.UI.Converters"
        mc:Ignorable="d"
        Title="PC Service Manager" 
        Height="840" 
        Width="1280"
        MinHeight="680" 
        MinWidth="960"
        WindowStartupLocation="CenterScreen"
        ExtendsContentIntoTitleBar="True"
        WindowBackdropType="Mica">

    <ui:FluentWindow.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVis"/>
        <converters:NullToVisibilityConverter x:Key="NullToVis"/>
    </ui:FluentWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Windows 11 Fluent Title Bar -->
        <ui:TitleBar Grid.Row="0" Title="PC Service Manager" ShowMaximize="True" ShowMinimize="True">
            <ui:TitleBar.Header>
                <StackPanel Orientation="Horizontal" Margin="12,0,0,0">
                    <ui:SymbolIcon Symbol="Wrench24" FontSize="16" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" Margin="0,0,8,0"/>
                    <TextBlock Text="PC Service Manager" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    <Border Background="{DynamicResource ControlFillColorDefaultBrush}" CornerRadius="10" Padding="8,2" Margin="12,0,0,0" Visibility="{Binding ActivePc, Converter={StaticResource NullToVis}}">
                        <TextBlock Text="{Binding ActivePc.Name}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                    </Border>
                </StackPanel>
            </ui:TitleBar.Header>
        </ui:TitleBar>

        <!-- Main Workspace Shell -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="240"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Sidebar Navigation -->
            <Border Grid.Column="0" 
                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" 
                    BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}" 
                    BorderThickness="0,0,1,0">
                <Grid Margin="12,16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- App Title / Subtitle -->
                    <StackPanel Grid.Row="0" Margin="12,0,12,20">
                        <TextBlock Text="SERVICE MANAGER" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" Margin="0,0,0,2"/>
                        <TextBlock Text="Digital Service Book" FontSize="13" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                    </StackPanel>

                    <!-- Navigation Items List -->
                    <StackPanel Grid.Row="1">
                        <!-- Dashboard Button -->
                        <ui:Button Command="{Binding NavigateToCommand}" CommandParameter="Dashboard" 
                                HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" 
                                Height="40" Margin="0,0,0,6" Padding="12,0" Appearance="Transparent">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Grid24" FontSize="18" Margin="0,0,12,0"/>
                                <TextBlock Text="Dashboard" FontSize="14" FontWeight="Medium" VerticalAlignment="Center"/>
                            </StackPanel>
                        </ui:Button>

                        <!-- Maintenance Tasks Button -->
                        <ui:Button Command="{Binding NavigateToCommand}" CommandParameter="Maintenance" 
                                HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" 
                                Height="40" Margin="0,0,0,6" Padding="12,0" Appearance="Transparent">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="CheckboxChecked24" FontSize="18" Margin="0,0,12,0"/>
                                <TextBlock Text="Maintenance Tasks" FontSize="14" FontWeight="Medium" VerticalAlignment="Center"/>
                            </StackPanel>
                        </ui:Button>

                        <!-- Service Mode Button -->
                        <ui:Button Command="{Binding NavigateToCommand}" CommandParameter="ServiceMode" 
                                HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" 
                                Height="40" Margin="0,0,0,6" Padding="12,0" Appearance="Transparent">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="PlayCircle24" FontSize="18" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" Margin="0,0,12,0"/>
                                <TextBlock Text="Service Mode" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </ui:Button>

                        <!-- Service History Button -->
                        <ui:Button Command="{Binding NavigateToCommand}" CommandParameter="History" 
                                HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" 
                                Height="40" Margin="0,0,0,6" Padding="12,0" Appearance="Transparent">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="History24" FontSize="18" Margin="0,0,12,0"/>
                                <TextBlock Text="Service Book" FontSize="14" FontWeight="Medium" VerticalAlignment="Center"/>
                            </StackPanel>
                        </ui:Button>

                        <!-- PC Information Button -->
                        <ui:Button Command="{Binding NavigateToCommand}" CommandParameter="PcInfo" 
                                HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" 
                                Height="40" Margin="0,0,0,6" Padding="12,0" Appearance="Transparent">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Info24" FontSize="18" Margin="0,0,12,0"/>
                                <TextBlock Text="PC Info &amp; Tools" FontSize="14" FontWeight="Medium" VerticalAlignment="Center"/>
                            </StackPanel>
                        </ui:Button>

                        <!-- Settings Button -->
                        <ui:Button Command="{Binding NavigateToCommand}" CommandParameter="Settings" 
                                HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" 
                                Height="40" Margin="0,0,0,6" Padding="12,0" Appearance="Transparent">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Settings24" FontSize="18" Margin="0,0,12,0"/>
                                <TextBlock Text="Settings &amp; Backup" FontSize="14" FontWeight="Medium" VerticalAlignment="Center"/>
                            </StackPanel>
                        </ui:Button>
                    </StackPanel>

                    <!-- Bottom Active PC Status Pill -->
                    <Border Grid.Row="2" Background="{DynamicResource ControlFillColorDefaultBrush}" CornerRadius="8" Padding="12,10" Visibility="{Binding ActivePc, Converter={StaticResource NullToVis}}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <ui:SymbolIcon Grid.Column="0" Symbol="Desktop24" FontSize="18" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{Binding ActivePc.Name}" FontWeight="SemiBold" FontSize="12" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="Active Asset" FontSize="10" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <!-- Main Content Container -->
            <ContentControl Grid.Column="1" Content="{Binding CurrentView}" Focusable="False"/>
        </Grid>
    </Grid>
</ui:FluentWindow>
